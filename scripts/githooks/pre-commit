#!/bin/bash
#
# Reject commits while po/POTFILES.in drifts from git-tracked sources,
# the po/ tree carries modifications not staged for this commit, or a
# catalog entry turns newly fuzzy or newly untranslated.
# Runs make po-refresh between the POTFILES.in check and the staging check
# (idempotent: the merge strips obsolete entries and discards its own
# reference-line churn) so string-only drift surfaces.
#
# Bypass:  FORCE_COMMIT=true git commit ...
#
# Installed by scripts/po/po-update.sh --sync via core.hooksPath.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ "${FORCE_COMMIT:-}" != "true" ]; then
	# Gate 1: POTFILES.in must match the git-tracked source list.
	# Show the drift listing only on failure; stay quiet when clean.
	if ! check_output=$(./scripts/po/po-update.sh --check 2>&1); then
		echo "$check_output"
		echo ""
		echo "❌ Pre-commit validation failed"
		echo ""
		echo "po/POTFILES.in is out of date with the git-tracked source list."
		echo ""
		echo "Fix with:"
		echo ""
		echo "  ./scripts/po/po-update.sh --sync"
		echo "  git add po/POTFILES.in"
		echo ""
		echo "If you have determined this commit must proceed anyway:"
		echo ""
		echo "  FORCE_COMMIT=true git commit"
		echo ""
		exit 1
	fi

	# Gate 2: refresh xnec2c.pot and merge .po catalogs so string-only
	# changes land in the po/ tree before the staging check below. Each
	# producer discards its own churn, so Gate 3 blocks solely on genuine
	# drift.
	if [ -f po/Makefile ]; then
		if ! po_output=$(make -s po-refresh 2>&1); then
			echo "$po_output"
			echo ""
			echo "❌ Pre-commit validation failed: make po-refresh failed"
			echo ""
			exit 1
		fi
	else
		echo "pre-commit: po/Makefile missing (tree not configured); po-refresh skipped." >&2
	fi

	# Gate 3: translation files must land with the commit that changed them.
	if ! git diff --quiet -- po; then
		echo ""
		echo "❌ Pre-commit validation failed"
		echo ""
		echo "po/ tree modified but not staged for commit:"
		echo ""
		git status -s -- po
		echo ""
		echo "Fix with:"
		echo ""
		echo "  git add po/"
		echo ""
		echo "If you have determined this commit must proceed anyway:"
		echo ""
		echo "  FORCE_COMMIT=true git commit"
		echo ""
		exit 1
	fi

	# Gate 4: no commit introduces a new fuzzy or untranslated entry.
	# Work-tree catalogs are compared against HEAD, so entries already fuzzy
	# on committed history never block and po-refresh line churn never
	# registers; an unborn HEAD compares against the empty tree.
	delta_base=$(git rev-parse --verify --quiet HEAD || echo 4b825dc642cb6eb9a060e54bf8d69288fbee4904)
	delta_rc=0

	while read -r lang; do
		po="po/$lang.po"
		# Skip languages whose catalog is absent from the work tree.
		[ -f "$po" ] || continue
		if ! delta_output=$(scripts/po/po-delta.sh "$delta_base" "$po"); then
			printf '%s\n' "$delta_output"
			delta_rc=1
		fi
	done < <(grep -v '^[[:space:]]*#' po/LINGUAS | grep -v '^[[:space:]]*$')

	if [ "$delta_rc" -ne 0 ]; then
		echo ""
		echo "❌ Pre-commit validation failed"
		echo ""
		echo "This commit introduces new fuzzy or untranslated catalog entries."
		echo "Translate or resolve the entries listed above and stage po/."
		echo ""
		echo "If you have determined this commit must proceed anyway:"
		echo ""
		echo "  FORCE_COMMIT=true git commit"
		echo ""
		exit 1
	fi

	# Gate 5: examples/ tree must match the Makefile.am distribution list.
	if [ -f Makefile ]; then
		if ! check_output=$(make -s check-deck 2>&1); then
			echo "$check_output"
			echo ""
			echo "❌ Pre-commit validation failed: make check-deck"
			echo ""
			echo "If you have determined this commit must proceed anyway:"
			echo ""
			echo "  FORCE_COMMIT=true git commit"
			echo ""
			exit 1
		fi
	else
		echo "pre-commit: Makefile missing (tree not configured); check-local skipped." >&2
	fi
fi

exit 0
