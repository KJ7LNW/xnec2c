#!/bin/bash
#
# Block a push whose tree fails the test suite. Runs make check once for the
# whole push; a push carrying only ref deletions publishes no tree and runs
# nothing. Catalog validation lives in the pre-commit hook.
#
# Bypass:  FORCE_PUSH=true git push ...
#
# Installed by scripts/po/po-update.sh --sync via core.hooksPath.

set -euo pipefail

[ "${FORCE_PUSH:-}" = "true" ] && exit 0

cd "$(git rev-parse --show-toplevel)"

pushes_tree=false

while read -r local_ref local_sha remote_ref remote_sha; do
	# Skip ref deletions: no pushed commit to test.
	[ -z "${local_sha//0/}" ] && continue
	pushes_tree=true
done

if ! $pushes_tree; then
	exit 0
fi

# make check needs a configured tree; report rather than pass untested work.
if [ ! -f Makefile ]; then
	echo ""
	echo "❌ Pre-push validation failed: tree not configured"
	echo ""
	echo "make check cannot run without a configured tree."
	echo ""
	echo "Fix with:"
	echo ""
	echo "  ./configure"
	echo ""
	echo "If you have determined this push must proceed anyway:"
	echo ""
	echo "  FORCE_PUSH=true git push"
	echo ""
	exit 1
fi

# Detach make from the ref list on stdin and stream progress to the terminal.
if ! make check </dev/null; then
	echo ""
	echo "❌ Pre-push validation failed: make check"
	echo ""
	echo "Fix the failing tests, commit, and push again."
	echo ""
	echo "If you have determined this push must proceed anyway:"
	echo ""
	echo "  FORCE_PUSH=true git push"
	echo ""
	exit 1
fi

exit 0
