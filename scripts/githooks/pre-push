#!/bin/bash
#
# Block a push whose tree fails the test suite or the PO catalog gates. Runs
# make check, then make check-po, once for the whole push; a push carrying
# only ref deletions publishes no tree and runs nothing. The pre-commit hook
# holds the per-commit catalog staging and delta gates.
#
# Bypass:  FORCE_PUSH=true git push ...
#
# Installed by scripts/po/po-update.sh --sync via core.hooksPath.

set -euo pipefail

[ "${FORCE_PUSH:-}" = "true" ] && exit 0

cd "$(git rev-parse --show-toplevel)"

pushes_tree=false

while read -r local_ref local_sha remote_ref remote_sha; do
	# Skip ref deletions: no pushed commit to test.
	[ -z "${local_sha//0/}" ] && continue
	pushes_tree=true
done

if ! $pushes_tree; then
	exit 0
fi

# Both targets need a configured tree; report rather than pass untested work.
if [ ! -f Makefile ]; then
	echo ""
	echo "❌ Pre-push validation failed: tree not configured"
	echo ""
	echo "make check and make check-po cannot run without a configured tree."
	echo ""
	echo "Fix with:"
	echo ""
	echo "  ./configure"
	echo ""
	echo "If you have determined this push must proceed anyway:"
	echo ""
	echo "  FORCE_PUSH=true git push"
	echo ""
	exit 1
fi

# Detach make from the ref list on stdin and stream progress to the terminal.
# Test the build, then run the PO catalog maintenance gates.
for target in check check-po; do
	if ! make "$target" </dev/null; then
		echo ""
		echo "❌ Pre-push validation failed: make $target"
		echo ""
		echo "Fix the failures above, commit, and push again."
		echo ""
		echo "If you have determined this push must proceed anyway:"
		echo ""
		echo "  FORCE_PUSH=true git push"
		echo ""
		exit 1
	fi
done

exit 0
