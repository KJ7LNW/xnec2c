#: src/args.c:111
msgid "Usage: xnec2c [options] [<input-file-name>]"
msgstr "Uso: xnec2c [opzioni] [<input-file-name>]"

#: src/args.c:116
msgid "NEC2 input file to open"
msgstr "File di input NEC2 da aprire"

#: src/args.c:120
msgid "file must exist"
msgstr "Il file deve esistere"

#: src/args.c:124
msgid "creates the file when missing"
msgstr "Crea il file se manca"

#: src/args.c:129
msgid "child processes; 0 disables forking"
msgstr "Processi figli; 0 disabilita il fork"

#: src/args.c:133
msgid "enable batch mode, exit after the frequency loop runs"
msgstr ""
"Abilita la modalità batch, esce dopo l'esecuzione del ciclo di frequenza"

#: src/args.c:135
msgid "batch mode enabled, will exit after first loop\n"
msgstr "modalità batch abilitata, uscita dopo il primo ciclo\n"

#: src/args.c:137
msgid "disable pthreads and use the GTK loop for debugging"
msgstr "Disabilita pthreads e usa il ciclo GTK per il debug"

#: src/args.c:139
msgid "pthread freqloop disabled!\n"
msgstr "pthread freqloop disabilitato!\n"

#: src/args.c:141
msgid "print usage information and exit"
msgstr "Stampa informazioni sull'uso ed esce"

#: src/args.c:144
msgid "print xnec2c version number and exit"
msgstr "Stampa il numero di versione di xnec2c ed esce"

#: src/args.c:147
msgid "increase verbosity, can be specified multiple times"
msgstr "Aumenta la verbosità, può essere specificato più volte"

#: src/args.c:150
msgid "enable debug output (-dd includes backtraces)"
msgstr "Abilita l'output di debug (-dd include le tracce dello stack)"

#: src/args.c:153
msgid "suppress debug/verbose output"
msgstr "Sopprime l'output di debug/verboso"

#: src/args.c:159
msgid "math library threads per job (default: processors / jobs)"
msgstr ""
"thread della libreria matematica per processo (predefinito: processori / "
"processi)"

#: src/args.c:164
msgid "activate the optimizer immediately"
msgstr "Attiva immediatamente l'ottimizzatore"

#: src/args.c:167
msgid "skip geometry verification checks"
msgstr "Salta i controlli di verifica della geometria"

#: src/args.c:169
msgid "verify segments check disabled\n"
msgstr "verifica controllo segmenti disabilitata\n"

#: src/args.c:171
msgid "force overlap check on large models (>1000 segments)"
msgstr ""
"Forza il controllo di sovrapposizione su modelli grandi (>1000 segmenti)"

#: src/args.c:173
msgid "forcing overlap check on large models\n"
msgstr "controllo sovrapposizione forzato su modelli grandi\n"

#: src/args.c:175
msgid "report managed allocator live bytes per call site"
msgstr "Segnala i byte attivi dell'allocatore gestito per sito di chiamata"

#: src/args.c:177
msgid "managed allocator leak report enabled\n"
msgstr "report perdite allocatore gestito abilitato\n"

#: src/args.c:180
msgid ""
"The following arguments write to an output file after the frequency loop "
"completes.  These are useful to combine with --batch; if filenames are "
"specified without --batch, enable File->Optimizer Settings or they will not "
"be written."
msgstr ""
"I seguenti argomenti scrivono in un file di output dopo il completamento del "
"ciclo di frequenza. Sono utili in combinazione con --batch; se vengono "
"specificati nomi di file senza --batch, abilitare File->Optimizer Settings, "
"altrimenti non verranno scritti."

#: src/args.c:188
msgid "write CSV file of measurements"
msgstr "Scrive un file CSV delle misure"

#: src/args.c:192
msgid "write S1P file of S-parameters"
msgstr "Scrive un file S1P di S-parameters"

#: src/args.c:196
msgid "write S2P file, port-2 is max-gain"
msgstr "Scrive un file S2P, la porta 2 è il guadagno massimo"

#: src/args.c:200
msgid "write S2P file, port-2 is viewer-gain"
msgstr "Scrive un file S2P, la porta 2 è il guadagno del visualizzatore"

#: src/args.c:204
msgid "write CSV of the radiation pattern"
msgstr "Scrive un CSV del diagramma di radiazione"

#: src/args.c:208
msgid "write CSV of currents and charges"
msgstr "Scrive un CSV di correnti e cariche"

#: src/args.c:212
msgid "write gnuplot structure file"
msgstr "Scrive un file di struttura gnuplot"

#: src/args.c:216
msgid "write CSV of patch surface currents"
msgstr "Scrive un CSV delle correnti superficiali dei patch"

#: src/args.c:220
msgid "write full validation data tree"
msgstr "Scrive l'albero completo dei dati di validazione"

#: src/args.c:224
msgid "write PNG of the radiation pattern"
msgstr "Scrive un PNG del diagramma di radiazione"

#: src/args.c:228
msgid "x, y, z, iso, or quad views"
msgstr "Viste x, y, z, iso o quad"

#: src/args.c:235
msgid ""
"post-sweep selected frequency; absent, keep the previous saved frequency, or "
"center if none"
msgstr ""
"Frequenza selezionata dopo la scansione; se assente, mantiene la precedente "
"frequenza salvata oppure il centro se non presente"

