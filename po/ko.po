#: src/opt_ui_formula.c:46
#, c-format
msgid ""
"<b>minimize</b>: penalizes <i>%s</i> above <b>%s</b>\n"
"\n"
"score = (max(%s − <b>%s</b>, 0) / 𝑛)<sup><b>%s</b></sup>\n"
"            + τ / (1 + max(<b>%s</b> − %s, 0) / 𝑛)\n"
"\n"
"𝑛 = √(<b>%s</b>² + 1)  (normalization)\n"
"τ = (10<sup>−4</sup>)<sup><b>%s</b></sup>  (tension: residual gradient past "
"target)"
msgstr ""
"<b>minimize</b>: <i>%s</i> 값이 <b>%s</b>보다 크면 벌점을 부과합니다.\n"
"\n"
"score = (max(%s − <b>%s</b>, 0) / 𝑛)<sup><b>%s</b></sup>\n"
"            + τ / (1 + max(<b>%s</b> − %s, 0) / 𝑛)\n"
"\n"
"𝑛 = √(<b>%s</b>² + 1)  (정규화)\n"
"τ = (10<sup>−4</sup>)<sup><b>%s</b></sup>  (장력: 목표값을 지난 영역의 잔류 "
"기울기)"

#: src/opt_ui_formula.c:53
#, c-format
msgid ""
"<b>maximize</b>: penalizes <i>%s</i> below <b>%s</b>\n"
"\n"
"score = (max(<b>%s</b> − %s, 0) / 𝑛)<sup><b>%s</b></sup>\n"
"            + τ / (1 + max(%s − <b>%s</b>, 0) / 𝑛)\n"
"\n"
"𝑛 = √(<b>%s</b>² + 1)  (normalization)\n"
"τ = (10<sup>−4</sup>)<sup><b>%s</b></sup>  (tension: residual gradient past "
"target)"
msgstr ""
"<b>maximize</b>: <i>%s</i> 값이 <b>%s</b>보다 작으면 벌점을 부과합니다.\n"
"\n"
"score = (max(<b>%s</b> − %s, 0) / 𝑛)<sup><b>%s</b></sup>\n"
"            + τ / (1 + max(%s − <b>%s</b>, 0) / 𝑛)\n"
"\n"
"𝑛 = √(<b>%s</b>² + 1)  (정규화)\n"
"τ = (10<sup>−4</sup>)<sup><b>%s</b></sup>  (장력: 목표값을 지난 영역의 잔류 "
"기울기)"

#: src/opt_ui_formula.c:60
#, c-format
msgid ""
"<b>deviate</b>: penalizes <i>%s</i> away from <b>%s</b>\n"
"\n"
"score = |%s − <b>%s</b>|<sup><b>%s</b></sup>\n"
"\n"
"No normalization or tension term."
msgstr ""
"<b>deviate</b>: <i>%s</i> 값이 <b>%s</b>에서 벗어나면 벌점을 부과합니다.\n"
"\n"
"score = |%s − <b>%s</b>|<sup><b>%s</b></sup>\n"
"\n"
"정규화 항과 장력 항이 없습니다."

#: src/opt_ui_formula.c:146
msgid "<i>No goals enabled</i>"
msgstr "<i>활성화된 목표가 없습니다.</i>"

#: src/opt_ui_formula.c:154
msgid ""
"<b>F = Σ(scores) =</b>\n"
"<small><i>Optimizer minimizes F</i></small>"
msgstr ""
"<b>F = Σ(scores) =</b>\n"
"<small><i>최적화기는 F를 최소화합니다.</i></small>"

#: src/opt_ui_formula.c:705
msgid ""
"<span size='large' weight='bold'>Transform Directions</span>\n"
"\n"
"<b>minimize:</b> Lower values are better\n"
"    Penalty = ((value − target)<sup>+</sup> / √(target²+1))<sup>exp</sup>\n"
"    <i>Score approaches zero below target; penalizes excess above target</"
"i>\n"
"\n"
"<b>maximize:</b> Higher values are better\n"
"    Penalty = ((target − value)<sup>+</sup> / √(target²+1))<sup>exp</sup>\n"
"    <i>Score approaches zero above target; works for positive and negative "
"targets</i>\n"
"\n"
"<b>deviate:</b> Target a specific value\n"
"    Penalty = |value − target|<sup>exp</sup>\n"
"    <i>Penalizes deviation from target; score=0 when value = target</i>\n"
"\n"
"\n"
"<span size='large' weight='bold'>Reduction Functions</span>\n"
"\n"
"<b>avg:</b> Average penalty across band\n"
"    <i>Balances all frequencies equally</i>\n"
"\n"
"<b>max:</b> Returns highest penalty (worst frequency point)\n"
"    <i>Optimizer improves the worst frequency first\n"
"    \"No point on the band can exceed X\"</i>\n"
"\n"
"<b>min:</b> Returns lowest penalty (best frequency point)\n"
"    <i>Optimizer improves the best frequency, ignores others\n"
"    Rarely useful (creates narrow-band solution)</i>\n"
"\n"
"<b>diff:</b> Returns penalty range (variation)\n"
"    <i>Makes metric consistent across band\n"
"    Use with gain_max for gain flatness</i>\n"
"\n"
"<b>sum:</b> Total penalty sum across all frequencies\n"
"    <i>Emphasizes overall error magnitude</i>\n"
"\n"
"<b>mag:</b> Root mean square magnitude\n"
"    sqrt(sum(penalty<sup>2</sup>))\n"
"    <i>Emphasizes large deviations more than average</i>\n"
"\n"
"\n"
"<span size='large' weight='bold'>Gain Direction Metrics</span>\n"
"\n"
"The gain_dev_* metrics measure angular deviation (in degrees)\n"
"between peak gain direction and a coordinate axis.\n"
"Use direction=minimize with target near 0 to steer the beam.\n"
"\n"
"    gain_dev_px: deviation from +X axis\n"
"    gain_dev_nx: deviation from -X axis\n"
"    gain_dev_py: deviation from +Y axis\n"
"    gain_dev_ny: deviation from -Y axis\n"
"    gain_dev_pz: deviation from +Z axis (zenith)\n"
"    gain_dev_nz: deviation from -Z axis (nadir)\n"
msgstr ""
"<span size='large' weight='bold'>변환 방향</span>\n"
"\n"
"<b>minimize:</b> 값이 작을수록 좋습니다.\n"
"    Penalty = ((value − target)<sup>+</sup> / √(target²+1))<sup>exp</sup>\n"
"    <i>목표값보다 낮으면 점수가 0에 가까워지고, 목표값을 초과하면 벌점이 부과"
"됩니다.</i>\n"
"\n"
"<b>maximize:</b> 값이 클수록 좋습니다.\n"
"    Penalty = ((target − value)<sup>+</sup> / √(target²+1))<sup>exp</sup>\n"
"    <i>목표값보다 높으면 점수가 0에 가까워지며, 양수와 음수 목표값에 모두 적"
"용됩니다.</i>\n"
"\n"
"<b>deviate:</b> 특정 값을 목표로 삼습니다.\n"
"    Penalty = |value − target|<sup>exp</sup>\n"
"    <i>목표값에서 벗어나면 벌점을 부과합니다. value = target이면 score=0입니"
"다.</i>\n"
"\n"
"\n"
"<span size='large' weight='bold'>집계 함수</span>\n"
"\n"
"<b>avg:</b> 대역 전체의 평균 벌점\n"
"    <i>모든 주파수에 동일한 비중을 둡니다.</i>\n"
"\n"
"<b>max:</b> 최대 벌점을 반환합니다(가장 불리한 주파수 지점).\n"
"    <i>최적화기는 가장 불리한 주파수 지점을 먼저 개선합니다.\n"
"    \"대역 내 어느 지점도 X를 초과할 수 없습니다.\"</i>\n"
"\n"
"<b>min:</b> 최소 벌점을 반환합니다(가장 유리한 주파수 지점).\n"
"    <i>최적화기는 가장 유리한 주파수 지점만 개선하고 나머지는 고려하지 않습니"
"다.\n"
"    협대역 해가 생기므로 유용한 경우가 드뭅니다.</i>\n"
"\n"
"<b>diff:</b> 벌점 범위(변동폭)를 반환합니다.\n"
"    <i>대역 전체에서 지표를 일정하게 유지합니다.\n"
"    이득을 평탄하게 하려면 gain_max와 함께 사용하십시오.</i>\n"
"\n"
"<b>sum:</b> 모든 주파수의 벌점 합계\n"
"    <i>전체 오차의 크기를 강조합니다.</i>\n"
"\n"
"<b>mag:</b> 제곱평균제곱근 크기\n"
"    sqrt(sum(penalty<sup>2</sup>))\n"
"    <i>평균보다 큰 편차에 더 큰 비중을 둡니다.</i>\n"
"\n"
"\n"
"<span size='large' weight='bold'>이득 방향 지표</span>\n"
"\n"
"gain_dev_* 지표는 최대 이득 방향과 좌표축 사이의\n"
"각도 편차를 도 단위로 측정합니다.\n"
"빔의 방향을 조정하려면 direction=minimize를 사용하고 target을 0에 가깝게 설정"
"하십시오.\n"
"\n"
"    gain_dev_px: +X 축 기준 편차\n"
"    gain_dev_nx: -X 축 기준 편차\n"
"    gain_dev_py: +Y 축 기준 편차\n"
"    gain_dev_ny: -Y 축 기준 편차\n"
"    gain_dev_pz: +Z 축 기준 편차 (천정)\n"
"    gain_dev_nz: -Z 축 기준 편차 (천저)\n"

