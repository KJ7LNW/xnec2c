msgstr "bắt buộc kiểm tra chồng lấp trên mô hình lớn (>1000 đoạn)"

#: src/args.c:175
msgid "forcing overlap check on large models\n"
msgstr "buộc kiểm tra chồng chéo trên mô hình lớn\n"

#: src/args.c:177
