msgstr "bật chế độ hàng loạt, thoát sau khi vòng lặp tần số chạy xong"

#: src/args.c:137
msgid "batch mode enabled, will exit after first loop\n"
msgstr "chế độ batch được bật, sẽ thoát sau vòng lặp đầu tiên\n"

#: src/args.c:139
msgid "disable pthreads and use the GTK loop for debugging"
msgstr "tắt pthreads và dùng vòng lặp GTK để gỡ lỗi"

