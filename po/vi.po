msgstr "bật đầu ra gỡ lỗi (-dd bao gồm dấu vết ngăn xếp)"

#: src/args.c:155
msgid "suppress debug/verbose output"
msgstr "chặn đầu ra gỡ lỗi/chi tiết"

#: src/args.c:161
msgid "math library threads per job (default: processors / jobs)"
msgstr ""
"Số luồng thư viện toán học mỗi công việc (mặc định: bộ xử lý / công việc)"

#: src/args.c:166
msgid "activate the optimizer immediately"
msgstr "kích hoạt ngay bộ tối ưu hoá"

#: src/args.c:169
msgid "skip geometry verification checks"
msgstr "bỏ qua kiểm tra xác minh hình học"

#: src/args.c:171
