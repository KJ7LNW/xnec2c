#: src/geometry.c:1150 src/geometry.c:1227 src/geometry.c:1305
msgid ""
"Geometry data error\n"
"Segment lies in plane of symmetry"
msgstr ""
"வடிவியல் தரவுப் பிழை\n"
"பிரிவு சமச்சீர் தளத்தில் உள்ளது"

#: src/geometry.c:1186 src/geometry.c:1263 src/geometry.c:1338
#, c-format
msgid "geometry data error: patch %d lies in plane of symmetry\n"
msgstr "வடிவியல் தரவுப் பிழை: தொகுதி %d சமச்சீர் தளத்தில் உள்ளது\n"

#: src/geometry.c:1187 src/geometry.c:1264 src/geometry.c:1339
msgid ""
"Geometry data error\n"
"Patch lies in plane of symmetry"
msgstr ""
"வடிவியல் தரவுப் பிழை\n"
"தொகுதி சமச்சீர் தளத்தில் உள்ளது"

#: src/geometry.c:1459
#, c-format
msgid ""
"tag=%d/seg=%d: endpoint distance=%.3e is too close (below connection "
"threshold=%.3e); segment will connect to itself\n"
msgstr ""
"tag=%d/seg=%d: முனைப்புள்ளித் தூரம்=%.3e மிக அருகில் உள்ளது (இணைப்பு வரம்பு=%.3e "
"க்குக் கீழே); பிரிவு தன்னுடன் தானே இணையும்\n"

#: src/geometry.c:1464
#, c-format
msgid "tag=%d: suppressing additional self-connection warnings\n"
msgstr "tag=%d: கூடுதல் சுய-இணைப்பு எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1514
#, c-format
msgid ""
"tag=%d/seg=%d: distance=%.3e to tag=%d/seg=%d closer than 2x connection "
"threshold %.3e; unintended connections possible\n"
msgstr ""
"tag=%1$d/seg=%2$d: tag=%4$d/seg=%5$d க்கான தூரம்=%3$.3e இணைப்பு வரம்பு %6$.3e இன் "
"2 மடங்கை விட அருகில் உள்ளது; உத்தேசிக்காத இணைப்புகள் சாத்தியம்\n"

#: src/geometry.c:1520
#, c-format
msgid "tag=%d: suppressing additional overlap warnings\n"
msgstr "tag=%d: கூடுதல் மேலெழுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1589
#, c-format
msgid ""
"tag=%d/seg=%d: length=%.3e is too short (and close enough) to tag=%d/seg=%d "
"length=%.3e that connection detection may fail or short\n"
msgstr ""
"tag=%d/seg=%d: நீளம்=%.3e மிகக் குறுகியது (மற்றும் tag=%d/seg=%d நீளம்=%.3e க்கு "
"போதுமான அளவு அருகில்) உள்ளதால் இணைப்புக் கண்டறிதல் தோல்வியடையலாம் அல்லது குறுக்கலாம்\n"

#: src/geometry.c:1595
#, c-format
msgid ""
"tag=%d: suppressing additional connection detection may fail or short "
"warnings\n"
msgstr ""
"tag=%d: இணைப்புக் கண்டறிதல் தோல்வி அல்லது குறுக்கல் தொடர்பான கூடுதல் எச்சரிக்கைகளை "
"அடக்குகிறது\n"

#: src/geometry.c:1628
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f < 0.001; similarity of "
"current components leads to numerical inaccuracies (min=0.001, fine=0.05, "
"recommended <= 0.1)\n"
msgstr ""
"tag=%d/seg=%d: நீளம்/அலைநீள விகிதம் %.3f < 0.001; மின்னோட்ட கூறுகளின் ஒற்றுமை எண் "
"துல்லியமின்மைக்கு வழிவகுக்கும் (min=0.001, fine=0.05, recommended <= 0.1)\n"

#: src/geometry.c:1633
#, c-format
msgid "tag=%d: suppressing additional short wavelength ratio errors\n"
msgstr "tag=%d: குறு அலைநீள விகிதப் பிழைகளின் கூடுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1647
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f > 0.1; current sampling "
"resolution limited by segment spacing (min=0.001, fine=0.05, recommended <= "
"0.1)\n"
msgstr ""
"tag=%d/seg=%d: நீளம்/அலைநீள விகிதம் %.3f > 0.1; மின்னோட்ட மாதிரி தீர்மானம் பிரிவு "
"இடைவெளியால் வரம்பிடப்பட்டுள்ளது (min=0.001, fine=0.05, recommended <= 0.1)\n"

#: src/geometry.c:1652
#, c-format
msgid "tag=%d: suppressing additional long wavelength ratio warnings\n"
msgstr "tag=%d: நீள அலைநீள விகிதத்தின் கூடுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1666
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f > 0.05; shorter segments "
"increase accuracy in regions of rapid current change (min=0.001, fine=0.05, "
"recommended <=0.1)\n"
msgstr ""
"tag=%d/seg=%d: நீளம்/அலைநீள விகிதம் %.3f > 0.05; விரைவான மின்னோட்ட மாற்றப் பகுதிகளில் "
"குறுகிய பிரிவுகள் துல்லியத்தை அதிகரிக்கும் (min=0.001, fine=0.05, recommended "
"<=0.1)\n"

#: src/geometry.c:1671
#, c-format
msgid "tag=%d: suppressing additional accuracy improvement suggestions\n"
msgstr "tag=%d: துல்லியம் மேம்பாட்டு பரிந்துரைகளின் கூடுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1702
#, c-format
msgid ""
"tag=%d/seg=%d: length/radius ratio of %.1f < 2.0; standard thin-wire kernel "
"field error exceeds 1%% by a large margin (min=2.0, 1%%accurate=8.0)\n"
msgstr ""
"tag=%d/seg=%d: நீளம்/ஆரம் விகிதம் %.1f < 2.0; நிலையான மெல்லிய-கம்பி கர்னல் புலப் பிழை "
"1%% ஐ பெரிய அளவில் மீறுகிறது (min=2.0, 1%%accurate=8.0)\n"

#: src/geometry.c:1707
#, c-format
msgid "tag=%d: suppressing additional standard kernel ratio errors\n"
msgstr "tag=%d: நிலையான கர்னல் விகிதப் பிழைகளின் கூடுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1721
#, c-format
msgid ""
"tag=%d/seg=%d: length/radius ratio of %.1f < 8.0; standard thin-wire kernel "
"field error exceeds 1%% (min=2.0, 1%%accurate=8.0)\n"
msgstr ""
"tag=%d/seg=%d: நீளம்/ஆரம் விகிதம் %.1f < 8.0; நிலையான மெல்லிய-கம்பி கர்னல் புலப் பிழை "
"1%% ஐ மீறுகிறது (min=2.0, 1%%accurate=8.0)\n"

#: src/geometry.c:1726
#, c-format
msgid "tag=%d: suppressing additional standard kernel ratio warnings\n"
msgstr "tag=%d: நிலையான கர்னல் விகிதத்தின் கூடுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1742
#, c-format
msgid ""
"tag=%d/seg=%d: length/radius ratio of %.1f < 0.5; extended thin-wire kernel "
"field error exceeds 1%% by a large margin (min=0.5, 1%%accurate=2.0)\n"
msgstr ""
"tag=%d/seg=%d: நீளம்/ஆரம் விகிதம் %.1f < 0.5; விரிவாக்கப்பட்ட மெல்லிய-கம்பி கர்னல் புலப் "
"பிழை 1%% ஐ பெரிய அளவில் மீறுகிறது (min=0.5, 1%%accurate=2.0)\n"

#: src/geometry.c:1747
#, c-format
msgid "tag=%d: suppressing additional extended kernel ratio errors\n"
msgstr ""
"tag=%d: விரிவாக்கப்பட்ட கர்னல் விகிதப் பிழைகளின் கூடுதல் எச்சரிக்கைகளை அடக்குகிறது\n"

#: src/geometry.c:1761
#, c-format
msgid ""
"tag=%d/seg=%d: length/radius ratio of %.1f < 2.0; extended thin-wire kernel "
"field error exceeds 1%% (min=0.5, 1%%accurate=2.0)\n"
