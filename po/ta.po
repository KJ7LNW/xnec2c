msgid "batch mode enabled, will exit after first loop\n"
msgstr "தொகுதி பயன்முறை இயக்கப்பட்டது, முதல் சுழற்சிக்குப் பின் வெளியேறும்\n"

#: src/args.c:137
msgid "disable pthreads and use the GTK loop for debugging"
msgstr "pthreads-ஐ முடக்கி, வழுநீக்கத்திற்காக GTK சுழற்சியைப் பயன்படுத்து"

