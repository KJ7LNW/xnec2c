#: src/args.c:111
msgid "Usage: xnec2c [options] [<input-file-name>]"
msgstr "Использование: xnec2c [параметры] [<имя-входного-файла>]"

#: src/args.c:116
msgid "NEC2 input file to open"
msgstr "Входной файл NEC2 для открытия"

#: src/args.c:120
msgid "file must exist"
msgstr "файл должен существовать"

#: src/args.c:124
msgid "creates the file when missing"
msgstr "создаёт файл при его отсутствии"

#: src/args.c:129
msgid "child processes; 0 disables forking"
msgstr "дочерние процессы; 0 отключает форк"

#: src/args.c:133
msgid "enable batch mode, exit after the frequency loop runs"
msgstr ""
"включить пакетный режим, завершить работу после выполнения цикла частот"

#: src/args.c:135
msgid "batch mode enabled, will exit after first loop\n"
msgstr "пакетный режим включён, выход после первого цикла\n"

#: src/args.c:137
msgid "disable pthreads and use the GTK loop for debugging"
msgstr "отключить pthreads и использовать цикл GTK для отладки"

#: src/args.c:139
msgid "pthread freqloop disabled!\n"
msgstr "pthread freqloop отключён!\n"

#: src/args.c:141
msgid "print usage information and exit"
msgstr "вывести сведения об использовании и завершить работу"

#: src/args.c:144
msgid "print xnec2c version number and exit"
msgstr "вывести номер версии xnec2c и завершить работу"

#: src/args.c:147
msgid "increase verbosity, can be specified multiple times"
msgstr "увеличить подробность вывода, можно указать несколько раз"

#: src/args.c:150
msgid "enable debug output (-dd includes backtraces)"
msgstr "включить отладочный вывод (-dd включает обратные трассировки)"

#: src/args.c:153
msgid "suppress debug/verbose output"
msgstr "подавить отладочный и подробный вывод"

#: src/args.c:159
msgid "math library threads per job (default: processors / jobs)"
msgstr ""
"Потоки математической библиотеки на задание (по умолчанию: процессоры / "
"задания)"

#: src/args.c:164
msgid "activate the optimizer immediately"
msgstr "немедленно активировать оптимизатор"

#: src/args.c:167
msgid "skip geometry verification checks"
msgstr "пропустить проверки геометрии"

#: src/args.c:169
msgid "verify segments check disabled\n"
msgstr "проверка сегментов отключена\n"

#: src/args.c:171
msgid "force overlap check on large models (>1000 segments)"
msgstr "принудительно проверить перекрытия в больших моделях (>1000 сегментов)"

#: src/args.c:173
msgid "forcing overlap check on large models\n"
msgstr "принудительная проверка перекрытий для больших моделей\n"

#: src/args.c:175
