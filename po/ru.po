#: src/geometry.c:1628
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f < 0.001; similarity of "
"current components leads to numerical inaccuracies (min=0.001, fine=0.05, "
"recommended <= 0.1)\n"
msgstr ""
"tag=%d/seg=%d: отношение длины к длине волны %.3f < 0.001; схожесть "
"компонентов тока приводит к численным неточностям (мин=0.001, норма=0.05, "
"рекомендуется <= 0.1)\n"

#: src/geometry.c:1633
#, c-format
msgid "tag=%d: suppressing additional short wavelength ratio errors\n"
msgstr ""
"tag=%d: подавление дополнительных ошибок малого отношения к длине волны\n"

#: src/geometry.c:1647
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f > 0.1; current sampling "
"resolution limited by segment spacing (min=0.001, fine=0.05, recommended <= "
"0.1)\n"
msgstr ""
"tag=%d/seg=%d: отношение длины к длине волны %.3f > 0.1; разрешение "
"дискретизации тока ограничено шагом сегментов (мин=0.001, норма=0.05, "
"рекомендуется <= 0.1)\n"

#: src/geometry.c:1652
#, c-format
msgid "tag=%d: suppressing additional long wavelength ratio warnings\n"
msgstr ""
"tag=%d: подавление дополнительных предупреждений о большом отношении к длине "
"волны\n"

#: src/geometry.c:1666
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f > 0.05; shorter segments "
"increase accuracy in regions of rapid current change (min=0.001, fine=0.05, "
"recommended <=0.1)\n"
msgstr ""
"tag=%d/seg=%d: отношение длины к длине волны %.3f > 0.05; более короткие "
"сегменты повышают точность в областях быстрого изменения тока (мин=0.001, "
"норма=0.05, рекомендуется <=0.1)\n"

#: src/geometry.c:1671
#, c-format
msgid "tag=%d: suppressing additional accuracy improvement suggestions\n"
msgstr "tag=%d: подавление дополнительных рекомендаций по повышению точности\n"

#: src/geometry.c:1702
