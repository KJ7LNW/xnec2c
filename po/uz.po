msgid "Usage: xnec2c [options] [<input-file-name>]"
msgstr "Foydalanish: xnec2c [options] [<input-file-name>]"

#: src/args.c:118
msgid "NEC2 input file to open"
msgstr "Ochish uchun NEC2 kirish fayli"

#: src/args.c:122
msgid "file must exist"
msgstr "fayl mavjud boʻlishi kerak"

