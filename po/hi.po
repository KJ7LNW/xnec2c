#: src/geometry.c:1628
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f < 0.001; similarity of "
"current components leads to numerical inaccuracies (min=0.001, fine=0.05, "
"recommended <= 0.1)\n"
msgstr ""
"tag=%d/seg=%d: लंबाई/तरंगदैर्घ्य अनुपात %.3f < 0.001; धारा घटकों की समानता संख्यात्मक "
"अशुद्धियों का कारण बनती है (न्यूनतम=0.001, उत्तम=0.05, अनुशंसित <= 0.1)\n"

#: src/geometry.c:1633
#, c-format
msgid "tag=%d: suppressing additional short wavelength ratio errors\n"
msgstr "tag=%d: अतिरिक्त लघु तरंगदैर्घ्य अनुपात त्रुटियाँ दबाई जा रही हैं\n"

#: src/geometry.c:1647
#, c-format
msgid ""
"tag=%d/seg=%d: length/wavelength ratio of %.3f > 0.1; current sampling "
"resolution limited by segment spacing (min=0.001, fine=0.05, recommended <= "
"0.1)\n"
msgstr ""
"tag=%d/seg=%d: लंबाई/तरंगदैर्घ्य अनुपात %.3f > 0.1; धारा सैंपलिंग रिज़ॉल्यूशन segment "
"अंतराल द्वारा सीमित (न्यूनतम=0.001, उत्तम=0.05, अनुशंसित <= 0.1)\n"

#: src/geometry.c:1652
#, c-format
msgid "tag=%d: suppressing additional long wavelength ratio warnings\n"
