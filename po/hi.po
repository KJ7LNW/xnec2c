#: src/geometry.c:1721
#, c-format
msgid ""
"tag=%d/seg=%d: length/radius ratio of %.1f < 8.0; standard thin-wire kernel "
"field error exceeds 1%% (min=2.0, 1%%accurate=8.0)\n"
msgstr ""
"tag=%d/seg=%d: लंबाई/त्रिज्या अनुपात %.1f < 8.0; मानक पतले-तार कर्नेल क्षेत्र त्रुटि 1%% "
