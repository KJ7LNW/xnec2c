msgid "creates the file when missing"
msgstr "अनुपस्थित होने पर फ़ाइल बनाता है"

#: src/args.c:131
msgid "child processes; 0 disables forking"
msgstr "चाइल्ड प्रक्रियाएँ; 0 fork को अक्षम करता है"

#: src/args.c:135
msgid "enable batch mode, exit after the frequency loop runs"
msgstr "बैच मोड सक्षम करें, आवृत्ति लूप चलने के बाद बाहर निकलें"

#: src/args.c:137
msgid "batch mode enabled, will exit after first loop\n"
msgstr "बैच मोड सक्षम, पहले लूप के बाद बाहर निकलेगा\n"

