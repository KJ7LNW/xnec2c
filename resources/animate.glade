                            <property name="digits">2</property>
                            <property name="value-pos">right</property>
                            <property name="tooltip-text" translatable="yes">Longest arrow a cell draws, as a fraction of that cell's own pattern radius, so the arrows track whichever gain scale shapes the surface.</property>
