<?xml version="1.0" encoding="UTF-8"?>
<!-- The color panel both the rendering settings dialog and the animate dialog
     present.  render_settings_builder loads it beside
     settings/render_settings.glade, settings/opengl_settings.glade and
     settings/cairo_settings.glade, then appends color_tab_content as a
     GtkNotebook page; the animate dialog's builder loads it and packs
     color_tab_content into anim_color_host.

     Each builder resolves these ids in its own namespace, so a load yields one
     widget tree per window: color_tones[].scale_id and .row_id address the row
     of whichever builder a caller hands them, and rc_config binds one field to
     the pair through a widget group per builder. -->
<interface>
  <requires lib="gtk+" version="3.20"/>

  <object class="GtkAdjustment" id="anim_bright_floor_adjustment">
    <property name="upper">1</property>
    <property name="value">0.2</property>
    <property name="step-increment">0.01</property>
    <property name="page-increment">0.1</property>
  </object>
  <object class="GtkAdjustment" id="anim_fam_power_adjustment">
    <property name="lower">-2</property>
    <property name="upper">2</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="anim_fam_db_adjustment">
    <property name="lower">10</property>
    <property name="upper">120</property>
    <property name="value">40</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="anim_fam_asinh_adjustment">
    <property name="lower">-3</property>
    <property name="upper">1</property>
    <property name="value">-1</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="anim_fam_mulaw_adjustment">
    <property name="lower">1</property>
    <property name="upper">120</property>
    <property name="value">40</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="anim_fam_reinhard_adjustment">
    <property name="lower">-1.3</property>
    <property name="upper">1.3</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="anim_fam_sigmoid_adjustment">
    <property name="lower">-1</property>
    <property name="upper">1</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.5</property>
  </object>

  <object class="GtkSizeGroup" id="anim_color_proj_sizegroup">
    <property name="mode">horizontal</property>
    <widgets>
      <widget name="anim_color_proj_label"/>
      <widget name="anim_projsel_heading_animated"/>
      <widget name="anim_projsel_instant"/>
      <widget name="anim_projsel_polarity"/>
      <widget name="anim_projsel_phase"/>
      <widget name="anim_projsel_dual"/>
      <widget name="anim_projsel_heading_static"/>
      <widget name="anim_projsel_amplitude"/>
      <widget name="anim_projsel_standing"/>
      <widget name="anim_projsel_farfield"/>
    </widgets>
  </object>
  <object class="GtkSizeGroup" id="anim_seg_scale_sizegroup">
    <property name="mode">horizontal</property>
    <widgets>
      <widget name="anim_seg_scale_label"/>
      <widget name="anim_segscalesel_heading_animated"/>
      <widget name="anim_segscalesel_instant"/>
      <widget name="anim_segscalesel_heading_static"/>
      <widget name="anim_segscalesel_envelope"/>
      <widget name="anim_segscalesel_model"/>
    </widgets>
  </object>
  <object class="GtkSizeGroup" id="anim_color_family_sizegroup">
    <property name="mode">horizontal</property>
    <widgets>
      <widget name="anim_color_family_label"/>
      <widget name="anim_famsel_power"/>
      <widget name="anim_famsel_db"/>
      <widget name="anim_famsel_asinh"/>
      <widget name="anim_famsel_mulaw"/>
      <widget name="anim_famsel_reinhard"/>
      <widget name="anim_famsel_sigmoid"/>
      <widget name="anim_famsel_none"/>
    </widgets>
  </object>

  <object class="GtkMenu" id="anim_color_proj_menu">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkMenuItem" id="anim_projsel_heading_animated">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="sensitive">False</property>
        <property name="label" translatable="yes">Animated</property>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_instant">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Hue shows the peak magnitude s(n); brightness follows the traveling wave |cos(arg z + φ)|, floored so nulls stay visible.&#10;&#10;Animated: bright regions sweep along the structure as the phase advances.</property>
        <property name="label" translatable="yes">Instantaneous</property>
        <property name="active">True</property>
        <property name="draw-as-radio">True</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_polarity">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Diverging hue shows the instantaneous sign of the displayed quantity: cold negative, hot positive; brightness carries the magnitude s(n).&#10;&#10;Animated: regions swap poles as the phase advances.</property>
        <property name="label" translatable="yes">Polarity</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_projsel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_phase">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Cyclic hue wheel shows the phase angle arg z + φ; brightness carries the magnitude s(n).&#10;&#10;Animated: the whole wheel rotates as the phase advances.</property>
        <property name="label" translatable="yes">Phase Hue</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_projsel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_dual">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Diverging hue shows the instantaneous charge sign; brightness carries the current envelope s(|I|).&#10;&#10;Animated: one view of charge and current a quarter cycle apart.</property>
        <property name="label" translatable="yes">Current + Charge</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_projsel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="anim_projsel_heading_static">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="sensitive">False</property>
        <property name="label" translatable="yes">Static</property>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_amplitude">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Rainbow ramp of this frequency step's peak magnitude s(n) at full brightness.&#10;&#10;Static: the phase-invariant baseline; colors hold still during playback.</property>
        <property name="label" translatable="yes">Amplitude</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_projsel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_standing">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Hue ramps the per-region standing-wave ratio: cold traveling, hot standing; brightness carries the magnitude s(n).&#10;&#10;Static: a phase-invariant read; colors hold still during playback.</property>
        <property name="label" translatable="yes">Standing/Traveling</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_projsel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_projsel_farfield">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Hue ramps each segment's contribution to the selected far-field direction; brightness carries the magnitude s(n).&#10;&#10;Static: a phase-invariant read; colors hold still during playback.</property>
        <property name="label" translatable="yes">Far-field Contribution</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_projsel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
  </object>

  <object class="GtkMenu" id="anim_seg_scale_menu">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkMenuItem" id="anim_segscalesel_heading_animated">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="sensitive">False</property>
        <property name="label" translatable="yes">Animated</property>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_segscalesel_instant">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Scale each segment from the instantaneous magnitude s(n) · |cos(arg z + φ)|.&#10;&#10;Animated: scaled regions travel through phase peaks and contract at zero crossings as the phase advances.</property>
        <property name="label" translatable="yes">Instantaneous</property>
        <property name="draw-as-radio">True</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="anim_segscalesel_heading_static">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="sensitive">False</property>
        <property name="label" translatable="yes">Static</property>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_segscalesel_envelope">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Scale each segment from the peak magnitude s(n), enlarging strong regions and contracting nulls.&#10;&#10;Static: the phase-invariant scale holds still during playback.</property>
        <property name="label" translatable="yes">Envelope magnitude</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_segscalesel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_segscalesel_model">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Keep each segment at its model radius instead of scaling it by magnitude.</property>
        <property name="label" translatable="yes">Model radius</property>
        <property name="active">True</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_segscalesel_instant</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
  </object>

  <object class="GtkMenu" id="anim_color_family_menu">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_power">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Power-law transfer n^γ of the normalized magnitude.&#10;&#10;γ = 1 is linear amplitude; γ = 0.5 expands weak regions; γ = 2 shows the squared magnitude — |I|² is proportional to per-segment dissipated power (and its radiated-power contribution via radiation resistance), |q|² to stored electrostatic energy.</property>
        <property name="label" translatable="yes">Power</property>
        <property name="active">True</property>
        <property name="draw-as-radio">True</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_db">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Logarithmic transfer over a user range R, the RF-standard 20·log₁₀ amplitude decibels.&#10;&#10;R sets the visible dynamic range; detail below the floor 10^(−R/20) clips to the bottom color.</property>
        <property name="label" translatable="yes">dB</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_famsel_power</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_asinh">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Inverse hyperbolic sine: linear below the knee k, logarithmic above.&#10;&#10;Keeps near-null currents visible while compressing strong peaks, like a lin-log instrument scale.</property>
        <property name="label" translatable="yes">Asinh</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_famsel_power</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_mulaw">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">μ-law companding, the telephony-standard bounded log curve.&#10;&#10;Lifts weak detail without a hard floor; 48.16 dB compression is the classic μ = 255.</property>
        <property name="label" translatable="yes">μ-law</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_famsel_power</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_reinhard">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Reinhard rational compressor (1+k)·n/(n+k), the photographic HDR tone-map.&#10;&#10;Preserves midtones while rolling highlights off smoothly; k sets the knee.</property>
        <property name="label" translatable="yes">Reinhard</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_famsel_power</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_sigmoid">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Hyperbolic tangent soft limiter tanh(a·n)/tanh(a).&#10;&#10;Raises midrange contrast and saturates gently toward the peak, like amplifier compression; a sets the steepness.</property>
        <property name="label" translatable="yes">Sigmoid</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_famsel_power</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkRadioMenuItem" id="anim_famsel_none">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="tooltip-text" translatable="yes">Identity: every magnitude renders at full brightness.&#10;&#10;The color projection alone carries the information.</property>
        <property name="label" translatable="yes">None</property>
        <property name="draw-as-radio">True</property>
        <property name="group">anim_famsel_power</property>
        <signal name="activate" handler="on_config_widget_changed" swapped="no"/>
      </object>
    </child>
  </object>

  <!-- Color tab content: the projection, segment scale and tone controls the
       animate dialog also carries; both dialogs drive the same rc_config
       fields, so a selection made while animating stays reachable here once
       the animate dialog closes. -->
  <object class="GtkBox" id="color_tab_content">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <property name="margin-start">8</property>
    <property name="margin-end">8</property>
    <property name="margin-top">8</property>
    <property name="margin-bottom">8</property>

    <child>
      <object class="GtkGrid" id="color_selector_grid">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="row-spacing">6</property>
        <property name="column-spacing">12</property>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">Color projection:</property>
            <property name="valign">center</property>
          </object>
          <packing>
            <property name="left-attach">0</property>
            <property name="top-attach">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkMenuButton" id="anim_color_proj_button">
            <property name="valign">center</property>
            <property name="halign">start</property>
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="receives-default">False</property>
            <property name="tooltip-text" translatable="yes">Select which physical quantity drives the hue and how brightness follows the excitation phase.&#10;&#10;Static projections (Amplitude, Standing/Traveling, Far-field Contribution) read without animating.&#10;&#10;Hovering an entry previews it live.</property>
            <property name="popup">anim_color_proj_menu</property>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="anim_color_proj_label">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="icon-name">pan-down-symbolic</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="left-attach">1</property>
            <property name="top-attach">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="anim_proj_formula">
            <property name="valign">center</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="hexpand">True</property>
            <property name="use-markup">True</property>
          </object>
          <packing>
            <property name="left-attach">2</property>
            <property name="top-attach">0</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">Segment scale:</property>
            <property name="valign">center</property>
          </object>
          <packing>
            <property name="left-attach">0</property>
            <property name="top-attach">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkMenuButton" id="anim_seg_scale_button">
            <property name="valign">center</property>
            <property name="halign">start</property>
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="receives-default">False</property>
            <property name="tooltip-text" translatable="yes">Choose how current or charge magnitude changes segment thickness.&#10;&#10;Hover an entry to preview it.</property>
            <property name="popup">anim_seg_scale_menu</property>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="anim_seg_scale_label">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="icon-name">pan-down-symbolic</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="left-attach">1</property>
            <property name="top-attach">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="anim_seg_scale_formula">
            <property name="valign">center</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="hexpand">True</property>
            <property name="use-markup">True</property>
          </object>
          <packing>
            <property name="left-attach">2</property>
            <property name="top-attach">1</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">Scale family:</property>
            <property name="valign">center</property>
          </object>
          <packing>
            <property name="left-attach">0</property>
            <property name="top-attach">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkMenuButton" id="anim_color_family_button">
            <property name="valign">center</property>
            <property name="halign">start</property>
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="receives-default">False</property>
            <property name="tooltip-text" translatable="yes">Select the normalized-magnitude transfer shared by color brightness and segment scale.&#10;&#10;Adjust its slider until the contrast reveals the range your inspection needs.&#10;&#10;Hovering an entry previews it live.</property>
            <property name="popup">anim_color_family_menu</property>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="anim_color_family_label">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="icon-name">pan-down-symbolic</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="left-attach">1</property>
            <property name="top-attach">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="anim_scale_formula">
            <property name="valign">center</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="xalign">0</property>
            <property name="hexpand">True</property>
            <property name="use-markup">True</property>
          </object>
          <packing>
            <property name="left-attach">2</property>
            <property name="top-attach">2</property>
          </packing>
        </child>

        <child>
          <object class="GtkBox" id="anim_fam_rows_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="valign">center</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="anim_fam_row_power">
                <property name="valign">center</property>
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Gamma:</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScale" id="anim_fam_power">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="adjustment">anim_fam_power_adjustment</property>
                    <property name="round-digits">2</property>
                    <property name="digits">2</property>
                    <property name="value-pos">right</property>
                    <property name="tooltip-text" translatable="yes">Gamma exponent of the power transfer.&#10;&#10;γ = 0.5 expands weak regions, γ = 1 is linear, γ = 2 is proportional to dissipated power for currents.</property>
                    <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="anim_fam_row_db">
                <property name="valign">center</property>
                <property name="visible">False</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Range (dB):</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScale" id="anim_fam_db">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="adjustment">anim_fam_db_adjustment</property>
                    <property name="round-digits">0</property>
                    <property name="digits">0</property>
                    <property name="value-pos">right</property>
                    <property name="tooltip-text" translatable="yes">Dynamic range R below the step peak mapped onto the color strip.&#10;&#10;The floor is 10^(−R/20) of the peak.</property>
                    <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="anim_fam_row_asinh">
                <property name="valign">center</property>
                <property name="visible">False</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Softening:</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScale" id="anim_fam_asinh">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="adjustment">anim_fam_asinh_adjustment</property>
                    <property name="round-digits">2</property>
                    <property name="digits">2</property>
                    <property name="value-pos">right</property>
                    <property name="tooltip-text" translatable="yes">Softening knee k: linear below k, logarithmic above.</property>
                    <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="anim_fam_row_mulaw">
                <property name="valign">center</property>
                <property name="visible">False</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Compression (dB):</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScale" id="anim_fam_mulaw">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="adjustment">anim_fam_mulaw_adjustment</property>
                    <property name="round-digits">0</property>
                    <property name="digits">0</property>
                    <property name="value-pos">right</property>
                    <property name="tooltip-text" translatable="yes">Compression strength in dB; higher values lift weak detail.</property>
                    <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="anim_fam_row_reinhard">
                <property name="valign">center</property>
                <property name="visible">False</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Knee:</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScale" id="anim_fam_reinhard">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="adjustment">anim_fam_reinhard_adjustment</property>
                    <property name="round-digits">2</property>
                    <property name="digits">2</property>
                    <property name="value-pos">right</property>
                    <property name="tooltip-text" translatable="yes">Knee k of the rational soft-compressor.</property>
                    <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="anim_fam_row_sigmoid">
                <property name="valign">center</property>
                <property name="visible">False</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Contrast:</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScale" id="anim_fam_sigmoid">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="adjustment">anim_fam_sigmoid_adjustment</property>
                    <property name="round-digits">2</property>
                    <property name="digits">2</property>
                    <property name="value-pos">right</property>
                    <property name="tooltip-text" translatable="yes">Contrast steepness a of the tanh transfer.</property>
                    <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="anim_fam_row_none">
                <property name="valign">center</property>
                <property name="visible">False</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="left-attach">0</property>
            <property name="top-attach">3</property>
            <property name="width">3</property>
          </packing>
        </child>
        <child>
          <object class="GtkDrawingArea" id="anim_colorcode_drawingarea">
            <property name="width-request">96</property>
            <property name="height-request">24</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Color gradient of the active projection and scale family.</property>
            <signal name="draw" handler="on_colorcode_drawingarea_draw" swapped="no"/>
          </object>
          <packing>
            <property name="left-attach">3</property>
            <property name="top-attach">3</property>
          </packing>
        </child>

        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Brightness floor:</property>
                <property name="valign">center</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkScale" id="anim_bright_floor">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="adjustment">anim_bright_floor_adjustment</property>
                <property name="round-digits">2</property>
                <property name="digits">2</property>
                <property name="value-pos">right</property>
                <property name="tooltip-text" translatable="yes">Minimum brightness under animation so elements cool toward this level instead of vanishing to black.</property>
                <signal name="value-changed" handler="on_config_widget_changed" swapped="no"/>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="left-attach">0</property>
            <property name="top-attach">4</property>
            <property name="width">3</property>
          </packing>
        </child>

        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Overlays:</property>
                <property name="valign">center</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkCheckButton" id="anim_overlay_nodes">
                <property name="label" translatable="yes">Nodes/antinodes</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">False</property>
                <property name="draw-indicator">True</property>
                <property name="tooltip-text" translatable="yes">Mark current nulls (plus tick) and peaks (cross tick) on wire segments.&#10;&#10;Marks derive from the phase-invariant envelope, so they hold still while the wave animates.</property>
                <signal name="toggled" handler="on_config_widget_changed" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkCheckButton" id="anim_overlay_comet">
                <property name="label" translatable="yes">Comet</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">False</property>
                <property name="draw-indicator">True</property>
                <property name="tooltip-text" translatable="yes">Ride a bright head on the instantaneous positive crest so wave motion reads along each wire.</property>
                <signal name="toggled" handler="on_config_widget_changed" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="left-attach">0</property>
            <property name="top-attach">5</property>
            <property name="width">3</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">0</property>
      </packing>
    </child>

    <child>
      <object class="GtkLabel">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="xalign">0</property>
        <property name="use-markup">True</property>
        <property name="label">&lt;small&gt;&lt;i&gt;n = |z| / max|z|,  s = scale transfer,  φ = phase&lt;/i&gt;&lt;/small&gt;</property>
        <property name="valign">center</property>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">1</property>
      </packing>
    </child>

    <child>
      <object class="GtkButtonBox" id="color_tab_buttonbox">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="layout-style">end</property>
        <property name="margin-top">8</property>
        <child>
          <object class="GtkButton" id="anim_color_reset">
            <property name="label" translatable="yes">Reset</property>
            <property name="valign">center</property>
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="receives-default">False</property>
            <property name="halign">end</property>
            <property name="tooltip-text" translatable="yes">Restore the color projection, segment scale, scale family, brightness floor, and every family parameter to their defaults.</property>
            <signal name="clicked" handler="on_anim_color_reset_clicked" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">2</property>
      </packing>
    </child>

  </object>

</interface>
